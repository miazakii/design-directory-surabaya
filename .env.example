# Salin file ini menjadi .env lalu isi token dari https://console.apify.com/settings/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kedalaman review per studio. Sinyal usia terkuat, tapi $0.0005 per review.
MAX_REVIEWS=50

# Batas biaya per run (USD). Actor berhenti kalau cap tercapai.
MAX_TOTAL_CHARGE_USD=10

# Opsional (semua punya default di src/config.js)
# TARGET_COUNT=100
# MIN_YEARS=2
# LOCATION_QUERY=Surabaya, Indonesia
# MAX_PLACES_PER_SEARCH=40
# CANDIDATE_TARGET=300
# CONTACTS_ENRICHMENT=true
# ENRICHMENT=true
# ENRICH_CONCURRENCY=6
# HTTP_TIMEOUT_MS=15000
# OUTPUT_FILE=studio-desain-surabaya.xlsx
